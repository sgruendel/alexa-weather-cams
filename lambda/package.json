{
  "name": "alexa-weather-cams",
  "version": "1.3.0",
  "description": "Alexa Skill to view DWD weather webcams",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "reinstall": "rm -rf ./node_modules && npm install",
    "test:unit": "node --env-file-if-exists=.env ./node_modules/c8/bin/c8.js --reporter=lcov --reporter=text mocha --timeout=7000 --file test/setup.js test/unit/*",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/mocha/bin/mocha.js --timeout=20000 test/integration/*",
    "test": "npm run test:unit",
    "lambda:zip": "zip -r /tmp/weatherCams.zip node_modules/ package* *.js *.json",
    "lambda:deploy": "npm run lambda:zip && aws lambda update-function-code --function-name weatherCams --zip-file fileb:///tmp/weatherCams.zip",
    "model:deploy": "node --env-file-if-exists=.env scripts/deploy-model.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgruendel/alexa-weather-cams.git"
  },
  "keywords": [
    "alexa",
    "skill",
    "dwd",
    "weather",
    "webcam",
    "opendata"
  ],
  "author": "Stefan Gründel",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/sgruendel/alexa-weather-cams/issues"
  },
  "homepage": "https://github.com/sgruendel/alexa-weather-cams#readme",
  "dependencies": {
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "i18next": "^26.4.2",
    "i18next-sprintf-postprocessor": "^0.2.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.0",
    "nock": "^14.0.17"
  }
}
